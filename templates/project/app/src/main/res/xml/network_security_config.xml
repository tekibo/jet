<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- System trust anchors only; cleartext is denied (https://developer.android.com/training/articles/security-config). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
